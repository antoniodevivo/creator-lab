# Copy with npm run setup. Keep real keys in .env only.
# Choose fireworks OR groq, then fill that provider's key.
TRANSCRIPTION_PROVIDER=fireworks
APIFY_TOKEN=
# Classifier: laya (local, free, no key; downloads ~1.7 GB on first use) or jev (TypeSafe API).
CLASSIFIER=laya
# Only needed with CLASSIFIER=jev.
TYPESAFE_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=
PORT=5190

# Local pacing ceilings. Lower these to fit your actual account limits.
FIREWORKS_REQUESTS_PER_MINUTE=60
GROQ_REQUESTS_PER_MINUTE=20
